# Copie este arquivo para terraform.tfvars e preencha os valores

aws_region   = "sa-east-1"
project_name = "f1rsters-tech-challenge-mecanica"
environment  = "dev"

# VPC (obtenha na sua conta AWS)
vpc_id              = "vpc-xxxxxxxxxxxxx"
private_subnet_ids  = ["subnet-xxxxxxxxxxxxx", "subnet-xxxxxxxxxxxxx"]
allowed_cidr_blocks = ["10.0.0.0/8"]

# Banco de dados
db_name     = "oficina"
db_username = "oficinauser"
db_password = "your_secure_password_here"
